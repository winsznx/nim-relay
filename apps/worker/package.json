{
  "name": "@nim-relay/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "preview": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:security": "vitest run src/security",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "4.13.5",
    "zod": "4.5.4",
    "@nim-relay/shared": "workspace:*",
    "@nim-relay/relay-protocol": "workspace:*",
    "@nim-relay/game-engine": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@cloudflare/vitest-plugin": "^1.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.128.0"
  }
}
