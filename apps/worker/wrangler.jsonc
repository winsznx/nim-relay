{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nim-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/r/*", "/invite/*", "/proof/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_ROOM", "class_name": "RelayRoom" }
    ]
  },
  // The declarative "exports" field (SQLite-backed DO classes without a
  // migrations array) requires a newer wrangler than the one currently
  // pinned as a peer by @cloudflare/vitest-pool-workers (resolved: 4.44.0,
  // vs. our direct 4.128.0). Using the legacy migrations array here keeps
  // local `wrangler dev`/deploy and the Workers Vitest pool on the same
  // page; revisit once vitest-pool-workers bumps its wrangler peer.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }
  ],
  "r2_buckets": [
    { "binding": "REPLAY_BUCKET", "bucket_name": "nim-relay-artifacts-dev" }
  ],
  // Local/dev + test values only. Production sets APP_ORIGIN/NIMIQ_* per
  // environment and injects SESSION_SECRET, DEVICE_HASH_SECRET,
  // RUN_CHALLENGE_SECRET, SUPABASE_SERVICE_ROLE_KEY via `wrangler secret`.
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "NIMIQ_NETWORK": "TestAlbatross",
    "NIMIQ_RPC_URL": "https://rpc.testnet.nimiqwatch.com/",
    "SESSION_SECRET": "dev-only-session-secret-not-for-production",
    "DEVICE_HASH_SECRET": "dev-only-device-hash-pepper-not-for-production",
    "RUN_CHALLENGE_SECRET": "dev-only-run-challenge-secret-not-for-production",
    "SUPABASE_URL": "http://localhost:54321",
    "SUPABASE_SERVICE_ROLE_KEY": "dev-only-placeholder"
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
