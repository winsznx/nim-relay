{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nim-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/ws/*", "/r/*", "/relay/*", "/journey/*", "/chronicle/*", "/runner/*", "/invite/*", "/daily", "/proof", "/proof/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_ROOM", "class_name": "RelayRoom" },
      { "name": "STATION_ROOM", "class_name": "StationRoom" }
    ]
  },
  // The declarative "exports" field (SQLite-backed DO classes without a
  // migrations array) requires a newer wrangler than the one currently
  // pinned as a peer by @cloudflare/vitest-pool-workers (resolved: 4.44.0,
  // vs. our direct 4.128.0). Using the legacy migrations array here keeps
  // local `wrangler dev`/deploy and the Workers Vitest pool on the same
  // page; revisit once vitest-pool-workers bumps its wrangler peer.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["StationRoom"] }
  ],
  // REPLAY_BUCKET (R2) is added back when replay-artifact storage is built
  // (Phase 4+). R2 is not yet enabled on the deploy account and nothing reads
  // the binding today, so it is omitted to keep `wrangler deploy` unblocked.
  //
  // Non-sensitive shared config only. APP_ORIGIN, SESSION_SECRET,
  // DEVICE_HASH_SECRET, RUN_CHALLENGE_SECRET, SUPABASE_URL and
  // SUPABASE_SERVICE_ROLE_KEY are set with `wrangler secret put` for the
  // deployed Worker and via apps/worker/.dev.vars (gitignored) for local
  // `wrangler dev` - see .dev.vars.example. With no SUPABASE_SERVICE_ROLE_KEY,
  // getAuthStore() falls back to the in-memory store.
  "vars": {
    "NIMIQ_NETWORK": "MainAlbatross",
    "NIMIQ_RPC_URL": "https://rpc.nimiqwatch.com/"
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/10 * * * *"]
  },
  "env": {
    "testnet": {
      "name": "nim-relay-testnet",
      "vars": {
        "NIMIQ_NETWORK": "TestAlbatross",
        "NIMIQ_RPC_URL": "https://rpc.testnet.nimiqwatch.com/"
      },
      "durable_objects": {
        "bindings": [
          { "name": "RELAY_ROOM", "class_name": "RelayRoom" },
          { "name": "STATION_ROOM", "class_name": "StationRoom" }
        ]
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
