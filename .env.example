# Names and comments only. Never commit real values.

# Cloudflare Worker runtime
SUPABASE_URL=                     # Supabase project REST URL
SUPABASE_SERVICE_ROLE_KEY=        # Worker secret; never exposed to browser
SESSION_SECRET=                   # HMAC secret for signing session tokens
DEVICE_HASH_SECRET=               # HMAC pepper for hashing raw Nimiq device identifiers
RUN_CHALLENGE_SECRET=             # HMAC secret for signing issued game-run challenges
NIMIQ_NETWORK=                    # TestAlbatross | MainAlbatross
NIMIQ_RPC_URL=                    # Public Nimiq RPC endpoint used for independent tx verification

# Vite frontend (VITE_ prefix only, public-safe values only)
VITE_APP_ORIGIN=                  # Public HTTPS origin, e.g. https://nim-relay.example.workers.dev
VITE_NIMIQ_NETWORK=               # TestAlbatross | MainAlbatross
