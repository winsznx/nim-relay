{
  "name": "nim-relay",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:game": "pnpm --filter @nim-relay/game-engine test",
    "test:worker": "pnpm --filter @nim-relay/worker test",
    "test:e2e": "pnpm --filter @nim-relay/web test:e2e",
    "test:replay": "pnpm --filter @nim-relay/game-engine test:replay",
    "benchmark": "pnpm -r --if-present run benchmark",
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @nim-relay/web dev",
    "dev:worker": "pnpm --filter @nim-relay/worker dev",
    "preview:worker": "pnpm --filter @nim-relay/worker preview",
    "verify:auth": "tsx scripts/verify/auth-e2e.ts",
    "verify:runs": "tsx scripts/verify/runs-e2e.ts",
    "verify:handoff": "tsx scripts/verify/handoff.ts"
  },
  "dependencies": {
    "@nim-relay/game-engine": "workspace:*",
    "@nim-relay/relay-protocol": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "eslint": "^9.38.0",
    "meshoptimizer": "^1.2.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
